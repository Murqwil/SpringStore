<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd">

    <changeSet id="06-create-sku-table" author="ss_sku">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ss_sku"/>
            </not>
        </preConditions>
        <createTable tableName="ss_sku">
            <column name="sku_id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="sku_name" type="VARCHAR(255)"/>
            <column name="description" type="VARCHAR(255)"/>


            <!--Посмотреть, как добавить enum skuPackageId, skuPrices,translations, productId-->
        </createTable>
    </changeSet>
</databaseChangeLog>
