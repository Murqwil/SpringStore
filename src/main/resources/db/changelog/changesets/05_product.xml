<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd">

    <changeSet id="05-create-product-table" author="ss_product">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ss_product"/>
            </not>
        </preConditions>
        <createTable tableName="ss_product">
            <column name="product_id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="product_name" type="VARCHAR(255)"/>
            <column name="is_available" type="BOOLEAN"/>
            <column name="commodity_type" type="VARCHAR(50)"/>
            <column name="drink_type" type="VARCHAR(50)"/>
            <column name="product_type" type="VARCHAR(50)"/>
            <column name="package_type" type="VARCHAR(50)"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
