<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd">

    <changeSet id="04-create-order-item-table" author="ss_order_item">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ss_order_item"/>
            </not>
        </preConditions>
        <createTable tableName="ss_order_item">
            <column name="item_id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="sku_name" type="VARCHAR(255)"/>
            <column name="description" type="VARCHAR(255)"/>
            <column name="price" type="BIGSERIAL"/>
            <column name="currency" type="VARCHAR(50)"/>

            <column name="order_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_order_item_order"
                             referencedTableName="ss_order"
                             referencedColumnNames="order_id"
                             deleteCascade="true"/>
            </column>

        </createTable>
    </changeSet>
</databaseChangeLog>
