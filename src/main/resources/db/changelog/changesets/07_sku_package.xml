<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd">

    <changeSet id="07-create-sku-package-table" author="ss_sku_package">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ss_sku_package"/>
            </not>
        </preConditions>
        <createTable tableName="ss_sku_package">
            <column name="sku_package_id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(255)"/>



            <!--Посмотреть, как добавить enum uom,amount,colorType и skuId-->
        </createTable>
    </changeSet>
</databaseChangeLog>
